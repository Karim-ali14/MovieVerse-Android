<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MovieVerse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- Brand -->
        <item name="colorPrimary">@color/mv_primary</item>
        <item name="colorOnPrimary">@color/mv_text_primary</item>
        <item name="colorSecondary">@color/mv_secondary</item>
        <item name="colorOnSecondary">@color/mv_text_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/mv_background</item>
        <item name="colorSurface">@color/mv_surface</item>
        <item name="colorOnSurface">@color/mv_text_primary</item>
        <item name="colorError">@color/mv_error</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/mv_background</item>
        <item name="android:navigationBarColor">@color/mv_background</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>


    <!-- Main Theme -->
    <style name="Theme.MovieVerse" parent="Base.Theme.MovieVerse" />

    <!-- Primary Button -->
    <style name="Widget.MovieVerse.Button.Primary" parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/mv_primary</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

    </style>

    <!-- Secondary Button -->
    <style name="Widget.MovieVerse.Button.Secondary" parent="Widget.Material3.Button.TonalButton">

        <item name="backgroundTint">@color/mv_surface_elevated</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

    </style>

    <!-- Text Button -->
    <style name="Widget.MovieVerse.Button.Text" parent="Widget.Material3.Button.TextButton">

        <item name="android:textColor">@color/mv_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>

    </style>

    <!-- Screen Headings: Discover Movies -->
    <style name="TextAppearance.MovieVerse.Headline"
        parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
    </style>

    <!-- Home Section Titles: Trending Now, Popular Movies -->
    <style name="TextAppearance.MovieVerse.SectionTitle"
        parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
    </style>

    <!-- Movie Card Titles -->
    <style name="TextAppearance.MovieVerse.MovieTitle"
        parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
    </style>

    <!-- Body Text: Descriptions -->
    <style name="TextAppearance.MovieVerse.Body"
        parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mv_text_secondary</item>
    </style>

    <!-- Movie Card: Movie Title -->
    <style name="TextAppearance.MovieVerse.MovieCard.Title"
        parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Movie Card: Metadata (Year, Genre) -->
    <style name="TextAppearance.MovieVerse.MovieCard.Metadata"
        parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/mv_text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- Movie Card: Rating -->
    <style name="TextAppearance.MovieVerse.MovieCard.Rating"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
    </style>

    <!-- Small Labels: Year, Rating, Genre -->
    <style name="TextAppearance.MovieVerse.Label"
        parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/mv_text_secondary</item>
    </style>

    <!-- Button Text -->
    <style name="TextAppearance.MovieVerse.Button"
        parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <!-- Input Container -->
    <style name="Widget.MovieVerse.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/mv_input_background</item>
        <item name="boxStrokeColor">@color/mv_input_stroke_selector</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/mv_input_hint</item>

    </style>

    <!-- Input Text -->
    <style name="Widget.MovieVerse.TextInputEditText"
        parent="Widget.Material3.TextInputEditText.OutlinedBox">

        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="android:textColorHint">@color/mv_input_hint</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:inputType">text</item>

    </style>
</resources>