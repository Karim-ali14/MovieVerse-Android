<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MovieVerse" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->

        <!-- Brand -->
        <item name="colorPrimary">@color/mv_primary</item>
        <item name="colorOnPrimary">@color/mv_text_primary</item>
        <item name="colorSecondary">@color/mv_secondary</item>
        <item name="colorOnSecondary">@color/mv_text_primary</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/mv_background</item>
        <item name="colorSurface">@color/mv_surface</item>
        <item name="colorOnSurface">@color/mv_text_primary</item>
        <item name="colorError">@color/mv_error</item>

        <!-- System Bars -->
        <item name="android:statusBarColor">@color/mv_background</item>
        <item name="android:navigationBarColor">@color/mv_background</item>
        <item name="android:windowLightStatusBar">false</item>

    </style>


    <!-- Main Theme -->
    <style name="Theme.MovieVerse" parent="Base.Theme.MovieVerse" />

    <!-- Primary Button -->
    <style name="Widget.MovieVerse.Button.Primary" parent="Widget.Material3.Button">

        <item name="backgroundTint">@color/mv_primary</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

    </style>

    <!-- Secondary Button -->
    <style name="Widget.MovieVerse.Button.Secondary" parent="Widget.Material3.Button.TonalButton">

        <item name="backgroundTint">@color/mv_surface_elevated</item>
        <item name="android:textColor">@color/mv_text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">45dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

    </style>

    <!-- Text Button -->
    <style name="Widget.MovieVerse.Button.Text" parent="Widget.Material3.Button.TextButton">

        <item name="android:textColor">@color/mv_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>

    </style>

</resources>